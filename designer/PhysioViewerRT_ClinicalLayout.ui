<?xml version='1.0' encoding='UTF-8'?>
<ui version="4.0">
 <class>PhysioViewerClinicalLayout</class>
 <widget class="QMainWindow" name="PhysioViewerClinicalLayout">
  <property name="windowTitle">
   <string>PhysioViewerRT — Live physiological signals</string>
  </property>
  <property name="styleSheet">
   <string>QWidget { color: #25234a; font-family: "Segoe UI"; font-size: 10pt; }
QMainWindow, QWidget#centralwidget { background: #f1f2f9; }
QFrame#workspaceHeader { background: #04003c; border-radius: 10px; }
QLabel#workspaceBrand { color: #ffffff; font-size: 17pt; font-weight: 600; }
QLabel#workspaceDescriptor { color: #c1c2df; font-size: 9pt; }
QLabel#workspaceBadge { color: #e5e4ff; background: #25215b; border: 1px solid #514b85; border-radius: 12px; padding: 5px 12px; font-size: 9pt; font-weight: 600; }
QTabWidget::pane { background: #fafafe; border: 1px solid #dfe1ef; border-radius: 10px; top: 4px; }
QTabBar::tab { background: transparent; color: #686887; padding: 10px 26px; margin: 0 6px 6px 0; border: 1px solid transparent; border-radius: 7px; font-weight: 600; }
QTabBar::tab:selected { color: #312b79; background: #ffffff; border-color: #d8d5ef; }
QTabBar::tab:hover:!selected { background: #e9e8f5; color: #25234a; }
QGroupBox { background: #ffffff; border: 1px solid #dfe1ef; border-radius: 10px; margin-top: 18px; padding: 16px 12px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 14px; padding: 0 7px; color: #35335b; }
QGroupBox#eegSourceGroup::title, QGroupBox#ppgSourceGroup::title, QGroupBox#edaSourceGroup::title { color: #38317f; }
QPushButton, QToolButton { background: #ffffff; border: 1px solid #cccde2; border-radius: 6px; padding: 5px 11px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { background: #f0eefb; border-color: #8a82be; }
QPushButton:pressed, QToolButton:pressed { background: #e5e0f5; }
QPushButton:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus, QToolButton:focus { border: 1px solid #5e54a2; }
QPushButton:disabled, QToolButton:disabled { color: #9998ae; background: #f5f5fa; border-color: #e8e7f1; }
QPushButton#EEGPlay, QPushButton#PPGPlay, QPushButton#EDAPlay { background: #312b79; color: white; border-color: #312b79; font-weight: 600; min-width: 76px; }
QPushButton#EEGPlay:hover, QPushButton#PPGPlay:hover, QPushButton#EDAPlay:hover { background: #1e185c; }
QPushButton#rawFollowLive, QPushButton#metricsFollowLive { color: #312b79; background: #eeecfa; border-color: #d4ceee; font-weight: 600; }
QPushButton#rawFollowLive:checked, QPushButton#metricsFollowLive:checked { color: white; background: #312b79; }
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit { background: #ffffff; border: 1px solid #cccde2; border-radius: 6px; padding: 4px 8px; min-height: 22px; selection-background-color: #312b79; }
QComboBox::drop-down { border: none; width: 23px; }
QComboBox QAbstractItemView { background: white; border: 1px solid #dfe1ef; selection-background-color: #e7e2f6; selection-color: #1e185c; padding: 5px; }
QCheckBox { spacing: 7px; padding: 3px 0; }
QLabel#EEGPlotTitle, QLabel#PPGPlotTitle, QLabel#EDAPlotTitle { font-size: 10pt; font-weight: 600; padding: 3px 9px; border-radius: 5px; }
QLabel#EEGPlotTitle, QLabel#PPGPlotTitle, QLabel#EDAPlotTitle { color: #38317f; background: #eeecfa; }
QLabel#rawRenderingStatus, QLabel#baselineSummary, QLabel#EYCStatus, QLabel#BSLStatus { color: #77768f; }
QLabel#sourcesIntro, QLabel#rawIntro, QLabel#metricsIntro { color: #686887; padding: 0 0 4px; }
QWidget#EEGPlotPanel, QWidget#PPGPlotPanel, QWidget#EDAPlotPanel { background: #ffffff; border: 1px solid #dfe1ef; border-radius: 8px; }
QFrame#EEGPlotHost, QFrame#PPGPlotHost, QFrame#EDAPlotHost, QFrame#metricsPlotHost { background: #ffffff; border: none; border-radius: 6px; }
QSplitter::handle { background: #f1f2f9; height: 8px; }
QSplitter::handle:hover { background: #c9c3e5; }
QStatusBar { background: #f1f2f9; color: #77768f; border-top: 1px solid #dfe1ef; font-size: 9pt; }
QToolTip { background: #04003c; color: white; border: none; padding: 7px; }

QFrame#metricsControlsCard, QFrame#metricsTrendCard, QFrame[metricCard="true"] { background: #ffffff; border: 1px solid #dfe1ef; border-radius: 9px; }
QFrame#EEGASRPanel { background: #fafafe; border: 1px solid #e5e3f1; border-radius: 7px; }
QLabel#EEGASRStatus { color: #77768f; font-size: 9pt; }
QLabel#metricsTrendTitle { color: #35335b; font-size: 11pt; font-weight: 600; }
QLabel[metricHeading="true"] { color: #77768f; font-size: 9pt; font-weight: 600; }
QLabel[metricValue="true"] { color: #25234a; font-size: 13pt; font-weight: 600; padding: 1px 0; }
QLabel[metricStatus="true"] { color: #77768f; font-size: 9pt; }
QCheckBox[metricSelector="true"] { background: #fafafe; border: 1px solid #e5e3f1; border-radius: 6px; padding: 6px 10px; }
QCheckBox[metricSelector="true"]:checked { background: #eeecfa; border-color: #d4ceee; }
</string>
