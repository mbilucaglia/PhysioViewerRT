<?xml version='1.0' encoding='UTF-8'?>
<ui version="4.0">
 <class>PhysioViewerClinicalLayout</class>
 <widget class="QMainWindow" name="PhysioViewerClinicalLayout">
  <property name="windowTitle">
   <string>PhysioViewerRT — Live physiological signals</string>
  </property>
  <property name="styleSheet">
   <string>QWidget { color: #243347; font-family: "Segoe UI"; font-size: 10pt; }
QMainWindow, QWidget#centralwidget { background: #eef2f6; }
QFrame#workspaceHeader { background: #152739; border-radius: 10px; }
QLabel#workspaceBrand { color: #ffffff; font-size: 17pt; font-weight: 600; }
QLabel#workspaceDescriptor { color: #a8bdcf; font-size: 9pt; }
QLabel#workspaceBadge { color: #85e0cf; background: #203f48; border: 1px solid #34575d; border-radius: 12px; padding: 5px 12px; font-size: 9pt; font-weight: 600; }
QTabWidget::pane { background: #f8fafc; border: 1px solid #dce3eb; border-radius: 10px; top: 4px; }
QTabBar::tab { background: transparent; color: #64748b; padding: 10px 26px; margin: 0 6px 6px 0; border: 1px solid transparent; border-radius: 7px; font-weight: 600; }
QTabBar::tab:selected { color: #0f766e; background: #ffffff; border-color: #d5e2e5; }
QTabBar::tab:hover:!selected { background: #e2e9ef; color: #243347; }
QGroupBox { background: #ffffff; border: 1px solid #dce3eb; border-radius: 10px; margin-top: 18px; padding: 16px 12px 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 14px; padding: 0 7px; color: #334155; }
QGroupBox#eegSourceGroup::title { color: #2563a6; }
QGroupBox#ppgSourceGroup::title { color: #b34870; }
QGroupBox#edaSourceGroup::title { color: #0f8272; }
QPushButton, QToolButton { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 5px 11px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { background: #edf7f6; border-color: #68aaa4; }
QPushButton:pressed, QToolButton:pressed { background: #d9efec; }
QPushButton:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QToolButton:focus { border: 1px solid #0d9488; }
QPushButton:disabled, QToolButton:disabled { color: #94a3b8; background: #f1f5f9; border-color: #e2e8f0; }
QPushButton#EEGPlay, QPushButton#PPGPlay, QPushButton#EDAPlay { background: #0f766e; color: white; border-color: #0f766e; font-weight: 600; min-width: 76px; }
QPushButton#EEGPlay:hover, QPushButton#PPGPlay:hover, QPushButton#EDAPlay:hover { background: #115e59; }
QPushButton#rawFollowLive, QPushButton#metricsFollowLive { color: #0f766e; background: #e8f6f2; border-color: #b7dfd3; font-weight: 600; }
QPushButton#rawFollowLive:checked, QPushButton#metricsFollowLive:checked { color: white; background: #0f766e; }
QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 4px 8px; min-height: 22px; selection-background-color: #0f766e; }
QComboBox::drop-down { border: none; width: 23px; }
QComboBox QAbstractItemView { background: white; border: 1px solid #dce3eb; selection-background-color: #def2ee; selection-color: #115e59; padding: 5px; }
QCheckBox { spacing: 7px; padding: 3px 0; }
QLabel#EEGPlotTitle, QLabel#PPGPlotTitle, QLabel#EDAPlotTitle { font-size: 10pt; font-weight: 600; padding: 3px 9px; border-radius: 5px; }
QLabel#EEGPlotTitle { color: #2563a6; background: #eaf2fc; }
QLabel#PPGPlotTitle { color: #a93e66; background: #fceef3; }
QLabel#EDAPlotTitle { color: #0f8272; background: #e5f5f0; }
QLabel#rawRenderingStatus, QLabel#baselineSummary, QLabel#EYCStatus, QLabel#BSLStatus { color: #738296; }
QLabel#sourcesIntro, QLabel#rawIntro, QLabel#metricsIntro { color: #64748b; padding: 0 0 4px; }
QWidget#EEGPlotPanel, QWidget#PPGPlotPanel, QWidget#EDAPlotPanel { background: #ffffff; border: 1px solid #dce3eb; border-radius: 8px; }
QFrame#EEGPlotHost, QFrame#PPGPlotHost, QFrame#EDAPlotHost, QFrame#metricsPlotHost { background: #ffffff; border: none; border-radius: 6px; }
QSplitter::handle { background: #eef2f6; height: 8px; }
QSplitter::handle:hover { background: #b8d7d3; }
QStatusBar { background: #eef2f6; color: #738296; border-top: 1px solid #dce3eb; font-size: 9pt; }
QToolTip { background: #152739; color: white; border: none; padding: 7px; }
</string>
